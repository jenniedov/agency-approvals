{
  // One install = one Worker + one D1. The installer replaces NAME and DATABASE_ID.
  "name": "agency-approvals",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/c/*", "/foryou", "/cover/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "agency-approvals", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "vars": { "APP_NAME": "Approvals" },
  "observability": { "enabled": true }
}
